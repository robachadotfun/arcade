# Arcade — environment template
#
# Copy to .env.local and fill in. NEVER commit .env.local.
#
# Variables prefixed NEXT_PUBLIC_ are inlined into the client bundle and are therefore
# PUBLIC. Everything else stays server-only. Nothing secret may ever carry that prefix.

# ─────────────────────────────────────────────────────────────────────────────
# Network  (required)
# ─────────────────────────────────────────────────────────────────────────────
# testnet  — real transactions on Arc Testnet against test-only contracts
# mainnet  — real transactions on Arc Mainnet, real USDC
#
# There is no demo or simulation mode. Every outcome Arcade shows is decided by the
# contract and read back from chain state; there is no code path that can invent one.
# The consequence is that Arcade needs a deployment to do anything. With this or any
# address below unset, it refuses to offer spins and names what is missing.
#
# Deliberately blank. With this unset, the build falls back to the deployment recorded in
# src/config/deployments.ts — the one this repository ships against. Setting it here
# overrides that, and a network with no manifest entry stays unconfigured rather than
# borrowing another network's addresses.
NEXT_PUBLIC_ARCADE_MODE=

# ─────────────────────────────────────────────────────────────────────────────
# Arc network (optional overrides)
# ─────────────────────────────────────────────────────────────────────────────
# Defaults are the public endpoints. Override with a dedicated provider for production:
# the activity tape reads event logs, which public endpoints tend to rate-limit.
#
#   Arc Mainnet  chain 5042     https://rpc.mainnet.arc.io
#   Arc Testnet  chain 5042002  https://rpc.testnet.arc.io
NEXT_PUBLIC_ARC_MAINNET_RPC_URL=
NEXT_PUBLIC_ARC_TESTNET_RPC_URL=

# Used by scripts/verify-arc-tokens.ts and by Foundry (contracts/foundry.toml).
ARC_MAINNET_RPC_URL=
ARC_TESTNET_RPC_URL=

# ─────────────────────────────────────────────────────────────────────────────
# Deployed contracts (required for testnet and mainnet)
# ─────────────────────────────────────────────────────────────────────────────
# Printed by: forge script script/Deploy.s.sol:Deploy --broadcast
#
# Leave blank to use src/config/deployments.ts. Set them to point a build at a different
# deployment without editing source — environment always wins over the manifest.
NEXT_PUBLIC_ARCADE_MACHINE_MANAGER=
NEXT_PUBLIC_ARCADE_PRIZE_VAULT=
NEXT_PUBLIC_ARCADE_REWARD_REGISTRY=
NEXT_PUBLIC_ARCADE_RANDOMNESS=
NEXT_PUBLIC_ARCADE_FEE_ROUTER=

# Onchain machine ids, as `slug:id` pairs. Printed by `pnpm operator machines`.
# A machine with no id here reports itself as not deployed and cannot be spun.
NEXT_PUBLIC_ARCADE_MACHINE_IDS=

# ─────────────────────────────────────────────────────────────────────────────
# Operator (server-only)
# ─────────────────────────────────────────────────────────────────────────────
# Signs the operator CLI's transactions: publishing commitments, posting the bond,
# registering tokens, funding the vault, creating machines, and — continuously —
# revealing randomness. See `pnpm operator`.
#
# PREFERRED: an encrypted keystore you create yourself. The key is read with echo
# disabled, so it never reaches your shell history, your scrollback, or any file here:
#
#   cast wallet import arcade-operator --interactive
#
# Then name it below. The CLI prompts for the password and holds the decrypted key in
# memory for one command only.
ARCADE_OPERATOR_ACCOUNT=

# Or point at a keystore JSON anywhere on disk (takes precedence over the name above).
ARCADE_OPERATOR_KEYSTORE=

# Only for unattended runs of `pnpm operator reveal`, which has to survive a restart with
# nobody present. This puts a secret back in the environment — source it from a process
# manager's secret store, never from a shell profile.
ARCADE_OPERATOR_PASSWORD=

# Last resort: a raw key in plaintext. Testnet and throwaway keys ONLY. Never give this
# the NEXT_PUBLIC_ prefix. For mainnet, use a hardware wallet — `forge script --ledger`
# for the deploy — so the key never reaches a Node process at all.
ARCADE_OPERATOR_PRIVATE_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Responsible play / compliance
# ─────────────────────────────────────────────────────────────────────────────
# These are MECHANISM, not legal advice. A production launch requires
# jurisdiction-specific legal review — see the README.
#
# Minimum self-attested age. Attestation only; Arcade does not verify identity.
NEXT_PUBLIC_ARCADE_MIN_AGE=18
# ISO 3166-1 alpha-2 codes that may not play, comma separated. Empty by default ON PURPOSE:
# a guessed jurisdiction list is worse than an obviously unconfigured one. Populate from
# legal review, and enforce at the edge — a client-side check is advisory.
NEXT_PUBLIC_ARCADE_BLOCKED_REGIONS=
# Per-session ceilings. 0 disables a limit.
NEXT_PUBLIC_ARCADE_SESSION_SPEND_LIMIT=100
NEXT_PUBLIC_ARCADE_SESSION_SPIN_LIMIT=50
NEXT_PUBLIC_ARCADE_SELF_EXCLUSION=true
NEXT_PUBLIC_ARCADE_SELF_EXCLUSION_DAYS=30

# ─────────────────────────────────────────────────────────────────────────────
# Admin console (server-only)
# ─────────────────────────────────────────────────────────────────────────────
# Minimum 24 characters. With this unset, /admin returns 404 rather than advertising an
# admin surface. A shared secret is adequate for one operator and NOT adequate for
# production — no identity, no audit trail, no revocation. See the production checklist.
ARCADE_ADMIN_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Deployment roles (server-only, used by forge script)
# ─────────────────────────────────────────────────────────────────────────────
# ARCADE_ADMIN should be a multisig for any real deployment. Every other role defaults to
# it, which is convenient on testnet and unacceptable on mainnet.
ARCADE_ADMIN=
ARCADE_MACHINE_ADMIN=
ARCADE_REGISTRY_ADMIN=
ARCADE_TREASURER=
ARCADE_RANDOMNESS_OPERATOR=
ARCADE_GUARDIAN=
ARCADE_REWARD_FUNDING_WALLET=
ARCADE_TREASURY_WALLET=

# ─────────────────────────────────────────────────────────────────────────────
# Art generation (server-only, optional)
# ─────────────────────────────────────────────────────────────────────────────
# Used ONLY by scripts/generate-arcade-art.ts at build time. Never imported by src/,
# never sent to the browser, never in the bundle. The site renders fully without it —
# every visual it depends on is hand-drawn SVG and CSS.
OPENAI_API_KEY=
# Override the image model if the default is unavailable to your account.
OPENAI_IMAGE_MODEL=

# ─────────────────────────────────────────────────────────────────────────────
# Site
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────────────────────
# Buyback (server-only, optional)
# ─────────────────────────────────────────────────────────────────────────────
# Router used by `pnpm operator buyback` to swap treasury USDC for ARCADE.
#
# Deliberately blank. ARCADE has no Uniswap v3 pool — its only liquidity is a v4
# pool — and no v4 router address is published in a source this repository can
# verify. Set this to a router you have checked yourself. The command refuses an
# address with no code and simulates the swap before spending anything, so a
# wrong value fails as a simulation error rather than a lost transfer.
ARCADE_BUYBACK_ROUTER=
